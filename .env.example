# CRM Toog : variables d'environnement
# Copiez ce fichier en .env sur le serveur, puis remplissez les valeurs.
# Ne mettez jamais ce .env sur GitHub ni dans une conversation.

# --- Le serveur ---
# Adresse publique du CRM, avec https, sans / final (ex. https://crm.mon-entreprise.fr)
APP_URL=
PORT=3000
# production ou development (en development, les codes de connexion s'affichent dans le terminal)
NODE_ENV=production
# Dossier de la base et des fichiers (PDF, logo)
DATA_DIR=./data
# Secret aléatoire de 64 caractères (install.sh le génère)
SESSION_SECRET=

# --- Le premier compte (install.sh les remplit) ---
# Adresse du gérant : il devient administrateur à sa première connexion
ADMIN_EMAIL=
# Domaine autorisé à se connecter (ex. mon-entreprise.fr) ; modifiable ensuite dans Paramètres › Accès
ALLOWED_DOMAIN=

# --- Connexion Google (Google Cloud › Google Auth Platform › Clients) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Compte de service Google (Analytics et Agenda) ---
# Le fichier JSON de la clé, encodé en base64 sur une seule ligne :
#   base64 -i cle.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID de la propriété Google Analytics 4 (un nombre)
GA4_PROPERTY_ID=

# --- Stripe (Développeurs › Clés API, puis Webhooks) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend (API Keys, puis Webhooks) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Expéditeur, ex. Mon Entreprise <devis@notif.mon-entreprise.fr>
MAIL_FROM=
# Adresse qui reçoit les réponses des clients et les alertes de l'équipe
MAIL_REPLY_TO=

# --- Cloudflare Turnstile (anti-spam des formulaires) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- API des formulaires du site (facultatif) ---
# Clé partagée si votre site envoie ses demandes par API (en-tête X-Api-Key)
SITE_API_KEY=

# --- Sauvegarde hors du serveur (facultatif) ---
# Cible rsync/scp, ex. sauvegarde@autre-serveur:/sauvegardes/crm
BACKUP_REMOTE=
